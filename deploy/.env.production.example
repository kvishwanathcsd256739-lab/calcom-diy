# ==========================================
# Cal.diy Production Environment Template
# ==========================================

# Public URLs (Replace with your domain)
NEXT_PUBLIC_WEBAPP_URL=https://draw.pixara.online
NEXTAUTH_URL=https://draw.pixara.online

# Security Keys (Generate with `openssl rand -base64 32` or `openssl rand -hex 32`)
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
CALENDSO_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32_or_base64_32
JWT_SECRET=replace_with_openssl_rand_base64_32
CRON_API_KEY=replace_with_openssl_rand_hex_32

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=calcom_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=calendso
DATABASE_URL=postgresql://calcom_user:replace_with_strong_database_password@calcom-database:5432/calendso?schema=public
DATABASE_DIRECT_URL=postgresql://calcom_user:replace_with_strong_database_password@calcom-database:5432/calendso?schema=public

# Redis Cache
REDIS_URL=redis://calcom-redis:6379

# Email Configuration (Option A: Gmail SMTP)
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Cal.diy
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_gmail_app_password

# Email Configuration (Option B: Resend)
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=notifications@yourdomain.com
